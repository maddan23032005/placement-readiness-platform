generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT")
  // Student extras
  rollNumber   String?
  branch       String?
  gradYear     Int?
  // Trainer extras
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batchMemberships BatchMember[]
  trainerBatches   Batch[]       @relation("TrainerBatches")
  attempts         Attempt[]
  createdTests     Test[]
  createdQuestions       QuestionMCQ[]
  createdCodingQuestions QuestionCoding[]
}

model Batch {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  trainers    User[]        @relation("TrainerBatches")
  members     BatchMember[]
  testBatches TestBatch[]
}

model BatchMember {
  userId  String
  batchId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([userId, batchId])
}

model QuestionMCQ {
  id             String   @id @default(cuid())
  text           String
  options        Json     // string[]
  correctOptions Json     // number[]
  topic          String
  difficulty     String   @default("MEDIUM")
  tags           Json     @default("[]") // string[]
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy     User           @relation(fields: [createdById], references: [id])
  testQuestions TestQuestion[]
  answers       AnswerMCQ[]
}

model Test {
  id              String    @id @default(cuid())
  title           String
  description     String?
  type            String    @default("MCQ")
  durationMins    Int
  startAt         DateTime?
  endAt           DateTime?
  negativeMarking Boolean   @default(false)
  negativeValue   Float     @default(0.25)
  status          String    @default("DRAFT")
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator   User           @relation(fields: [createdById], references: [id])
  questions TestQuestion[]
  batches   TestBatch[]
  attempts  Attempt[]
}

model TestBatch {
  testId  String
  batchId String
  test    Test  @relation(fields: [testId], references: [id], onDelete: Cascade)
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([testId, batchId])
}

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId       String?
  questionCodingId String?
  marks            Float  @default(1)
  order            Int

  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  question       QuestionMCQ?    @relation(fields: [questionId], references: [id])
  questionCoding QuestionCoding? @relation(fields: [questionCodingId], references: [id])

  @@unique([testId, order])
}

model Attempt {
  id            String    @id @default(cuid())
  testId        String
  studentId     String
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  status        String    @default("IN_PROGRESS")
  questionOrder Json?     // string[]

  test    Test      @relation(fields: [testId], references: [id])
  student       User           @relation(fields: [studentId], references: [id])
  answers       AnswerMCQ[]
  answersCoding AnswerCoding[]
  result        Result?

  @@unique([testId, studentId])
}

model AnswerMCQ {
  id              String   @id @default(cuid())
  attemptId       String
  questionId      String
  selectedOptions Json     // number[]
  isCorrect       Boolean?
  marksAwarded    Float?
  savedAt         DateTime @default(now())

  attempt  Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuestionMCQ @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Result {
  id             String   @id @default(cuid())
  attemptId      String   @unique
  totalScore     Float
  maxScore       Float
  percentile     Float?
  topicBreakdown Json     // { [topic]: { correct, total, score, maxScore } }
  timeTakenSecs  Int
  generatedAt    DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model QuestionCoding {
  id             String   @id @default(cuid())
  title          String
  description    String
  language       String   @default("javascript")
  starterCode    String
  testCases      Json     // Array of { input, expectedOutput, isHidden }
  solutionCode   String?
  topic          String
  difficulty     String   @default("MEDIUM")
  tags           Json     @default("[]") // string[]
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy     User           @relation(fields: [createdById], references: [id])
  testQuestions TestQuestion[]
  answers       AnswerCoding[]
}

model AnswerCoding {
  id              String   @id @default(cuid())
  attemptId       String
  questionId      String
  submittedCode   String
  isCorrect       Boolean?
  marksAwarded    Float?
  testCaseResults Json?    // Array of results per test case
  savedAt         DateTime @default(now())

  attempt  Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuestionCoding @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}
